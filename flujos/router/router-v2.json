    {
      "id": "f03e7175-97e0-59dc-8f75-feb6a0de5e07",
      "name": "Decidir",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Único nodo Code del Router. Las fases internas llegan desde nodos Set.\n// original nunca se modifica; solo ese objeto llega a los subflujos.\nconst input = $input.first().json;\nconst internal = !Object.prototype.hasOwnProperty.call(input, 'update_id') && !!input.fase;\nconst original = internal ? input.original : input;\nconst u = original || {};\nconst cb = u.callback_query;\nconst m = cb ? (cb.message || {}) : (u.message || {});\nconst chatId = String((m.chat || {}).id || '');\nconst state = $getWorkflowStaticData('global');\nconst now = Date.now();\nconst ttl = 24 * 60 * 60 * 1000;\nstate.pendientes = state.pendientes || {};\nconst pending = state.pendientes;\nfor (const [id, value] of Object.entries(pending)) {\n  if (!value || !Number.isFinite(value.creado) || now - value.creado >= ttl) delete pending[id];\n}\nconst cap = (limit) => {\n  const ids = Object.keys(pending).sort((a, b) => pending[a].creado - pending[b].creado);\n  while (ids.length > limit) delete pending[ids.shift()];\n};\ncap(50);\nconst out = (accion, extra = {}) => [{json: {original: u, chatId, accion, ...extra}}];\nconst route = (destino, motivo) => out(destino, {destino, motivo});\nconst normalize = text => String(text || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().trim();\nfunction classify(text) {\n  const t = normalize(text);\n  const amount = /(?:\\$\\s*\\d|\\d[\\d.,]*\\s*(?:k|mil|lucas|pesos|cop)\\b|\\b\\d{1,3}(?:\\.\\d{3})+(?:,\\d+)?\\b|\\d[\\d.,]*\\s*\\$)/.test(t);\n  // Con tilde (pagué) es pasado seguro; sin tilde puede ser subjuntivo (\"recuérdame que pague\").\n  const pastCierto = /(?:^|[^a-zñ])(?:pagué|gasté|compré|presté|transferí|aboné|invertí|recibí|cobré|me pagó)(?![a-zñ])/.test(String(text || '').toLowerCase());\n  const past = /\\b(?:pague|gaste|compre|preste|transferi|abone|inverti|recibi|cobre)\\b|\\bme pago\\b/.test(t);\n  const finance = amount || past || /\\b(?:saldo|saldos|nequi|bancolombia|rappi|nu|daviplata|efectivo|tarjeta|tarjetas|cuota|cuotas|deuda|deudas|prestamo|prestamos|inversion|inversiones|presupuesto|presupuestos|ingreso|ingresos|abono|abonos)\\b|\\b(?:me debe|le debo)\\b/.test(t);\n  const reminder = /\\b(?:recuerdame|recordatorio|recordatorios|avisame)\\b/.test(t);\n  const future = /\\b(?:voy a|tengo que|debo|hay que)\\s+(?:pagar|comprar|gastar|transferir|abonar|invertir)\\b|\\b(?:pagare|comprare|gastare|transferire|abonare|invertire)\\b/.test(t);\n  const assistant = reminder || future || /\\b(?:tarea|tareas|pendiente|pendientes|agenda|calendario|cita|citas|reunion|reuniones|clave|claves|contrasena|contrasenas)\\b|\\bya hice\\b|\\besta semana\\b/.test(t)\n    || (!amount && /\\b(?:cancela|cancelame)\\b/.test(t))\n    || (!finance && /\\b(?:manana a las|a las\\s+\\d)\\b/.test(t));\n  // Una acción financiera ya realizada se conserva en Finanzas.\n  if (reminder && !pastCierto) return 'asistente'; // 'recuérdame que pague…' es subjuntivo, no pasado\n  if (past) return 'finanzas';\n  if (future) return 'asistente';\n  if (finance && assistant) return 'duda';\n  if (finance) return 'finanzas';\n  if (assistant) return 'asistente';\n  return 'duda';\n}\nfunction ask(texto, motivo) {\n  cap(49);\n  state.secuencia = (Number(state.secuencia) || 0) + 1;\n  const id = now.toString(36) + '-' + String($execution.id).replace(/[^a-zA-Z0-9_-]/g, '').slice(0, 20) + '-' + state.secuencia.toString(36);\n  pending[id] = {creado: now, chatId, original: u};\n  return out('preguntar', {destino: 'duda', texto, motivo, pendienteId: id,\n    pregunta: '¿Esto es de 💰 Finanzas o 📅 Asistente?', callbackF: 'r:f:' + id, callbackA: 'r:a:' + id});\n}\n// La autorización precede incluso a botones r:, medios y fases internas.\nif (chatId !== '123456789') return route('finanzas', 'chat ajeno');\nif (internal) {\n  if (input.fase === 'despachar') {\n    return route(input.destino === 'asistente' ? 'asistente' : 'finanzas', 'elección confirmada');\n  }\n  if (input.fase === 'voz_error') return route('finanzas', 'falló descarga o Groq');\n  if (input.fase === 'ia' || input.fase === 'ia_error') {\n    const result = input.resultado || {};\n    const parts = result.content && result.content.parts;\n    const candidate = (result.candidates || [])[0];\n    const candidateParts = candidate && candidate.content && candidate.content.parts;\n    // Forma simplificada del nodo Gemini y forma nativa generateContent.\n    // No concatena alternativas: solo acepta exactamente una etiqueta.\n    const raw = typeof result === 'string' ? result\n      : typeof result.text === 'string' ? result.text\n      : Array.isArray(parts) ? parts.map(p => p.text || '').join('')\n      : Array.isArray(candidateParts) ? candidateParts.map(p => p.text || '').join('') : '';\n    const label = String(raw).trim();\n    if (input.fase !== 'ia_error' && !result.error && ['finanzas', 'asistente'].includes(label)) return route(label, 'Gemini');\n    return ask(input.texto || '', 'Gemini duda, inválido o error');\n  }\n  if (input.fase === 'voz') {\n    const r = input.resultado || {};\n    if (r.error || typeof r.text !== 'string' || !r.text.trim()) return route('finanzas', 'Groq sin transcripción válida');\n    const destino = classify(r.text);\n    return destino === 'duda' ? out('ia', {destino, texto: r.text}) : route(destino, 'transcripción');\n  }\n  return ask('', 'fase inválida');\n}\nif (cb) {\n  const data = String(cb.data || '');\n  if (data.startsWith('r:')) {\n    const match = /^r:([fa]):([a-zA-Z0-9_-]{1,55})$/.exec(data);\n    const saved = match && pending[match[2]];\n    if (!saved || saved.chatId !== chatId || String((cb.from || {}).id || '') !== chatId) {\n      return out('callback', {destino: null, callbackId: cb.id || '', respuesta: 'Ya lo envié', editar: false});\n    }\n    delete pending[match[2]];\n    const destino = match[1] === 'f' ? 'finanzas' : 'asistente';\n    return out('callback', {original: saved.original, destino, callbackId: cb.id || '',\n      respuesta: '', editar: true, messageId: m.message_id, etiqueta: destino === 'finanzas' ? '→ Finanzas' : '→ Asistente'});\n  }\n  return route(data.startsWith('a:') ? 'asistente' : 'finanzas', 'callback de subflujo');\n}\n// Voz/audio se transcriben; todos los demás adjuntos preceden a reply y texto.\nconst attachments = ['photo', 'document', 'video', 'animation', 'sticker', 'video_note', 'contact', 'location', 'venue', 'poll', 'dice', 'game', 'paid_media', 'story', 'invoice', 'successful_payment', 'passport_data', 'checklist'];\nif (attachments.some(key => m[key] != null)) return route('finanzas', 'adjunto');\nif (m.reply_to_message) {\n  const reply = m.reply_to_message;\n  return route((String(reply.text || '') + String(reply.caption || '')).includes('\\u2063') ? 'asistente' : 'finanzas', 'reply');\n}\nconst texto = String(m.text || m.caption || '').trim();\nif (texto.startsWith('/')) {\n  const command = normalize(texto.split(/\\s/)[0].split('@')[0]);\n  return route(['/tareas', '/pendientes', '/agenda', '/recordatorios', '/clave', '/claves'].includes(command) ? 'asistente' : 'finanzas', 'comando');\n}\nif (m.voice || m.audio) {\n  const fileId = (m.voice || m.audio).file_id;\n  return fileId ? out('voz', {fileId}) : route('finanzas', 'voz sin file_id');\n}\nconst destino = classify(texto);\nreturn destino === 'duda' ? out('ia', {destino, texto}) : route(destino, 'texto');\n"
      }
    },
